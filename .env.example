# Steadfast merchant credentials (portal.packzy.com > API settings)
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

# bKash tokenized checkout credentials
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Pathao Courier (merchant panel > Developer API)
# The smoke test falls back to Pathao's published sandbox credentials when these
# are unset, so leave them blank to try the sandbox with no setup.
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=

# RedX (merchant panel > API). No public sandbox credentials exist; the smoke
# script needs your own token and defaults to the sandbox host.
REDX_ACCESS_TOKEN=
REDX_STORE_ID=

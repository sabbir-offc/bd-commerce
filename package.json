{
  "name": "bd-commerce",
  "version": "0.4.1",
  "description": "Typed TypeScript clients for Bangladeshi commerce infrastructure. Steadfast, Pathao and RedX couriers, plus bKash and Nagad checkout, with zero runtime dependencies.",
  "keywords": [
    "bangladesh",
    "steadfast",
    "pathao",
    "redx",
    "bkash",
    "nagad",
    "courier",
    "payment",
    "cod",
    "ecommerce",
    "typescript"
  ],
  "license": "MIT",
  "author": "Md. Sabbir Howlader",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sabbir-offc/bd-commerce.git"
  },
  "bugs": {
    "url": "https://github.com/sabbir-offc/bd-commerce/issues"
  },
  "homepage": "https://github.com/sabbir-offc/bd-commerce#readme",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18.17"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./steadfast": {
      "types": "./dist/steadfast/index.d.ts",
      "import": "./dist/steadfast/index.js",
      "require": "./dist/steadfast/index.cjs"
    },
    "./bkash": {
      "types": "./dist/bkash/index.d.ts",
      "import": "./dist/bkash/index.js",
      "require": "./dist/bkash/index.cjs"
    },
    "./pathao": {
      "types": "./dist/pathao/index.d.ts",
      "import": "./dist/pathao/index.js",
      "require": "./dist/pathao/index.cjs"
    },
    "./redx": {
      "types": "./dist/redx/index.d.ts",
      "import": "./dist/redx/index.js",
      "require": "./dist/redx/index.cjs"
    },
    "./nagad": {
      "types": "./dist/nagad/index.d.ts",
      "import": "./dist/nagad/index.js",
      "require": "./dist/nagad/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "prepublishOnly": "pnpm run check",
    "smoke:bkash": "node --env-file-if-exists=.env --import tsx scripts/smoke-bkash.ts",
    "smoke:steadfast": "node --env-file-if-exists=.env --import tsx scripts/smoke-steadfast.ts",
    "smoke:pathao": "node --env-file-if-exists=.env --import tsx scripts/smoke-pathao.ts",
    "smoke:redx": "node --env-file-if-exists=.env --import tsx scripts/smoke-redx.ts",
    "smoke:nagad": "node --env-file-if-exists=.env --import tsx scripts/smoke-nagad.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@11.18.0"
}
